// Constraints for psram_bist_top - standalone PSRAM built-in-self-test,
// independent of the main MSX design (see psram_bist_top.vhd).

IO_LOC "clk_27m" 52;
IO_PORT "clk_27m" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

IO_LOC "btn_reset_n" 4;
IO_PORT "btn_reset_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Onboard USB-UART bridge TX (FPGA transmits, host PC's serial port receives).
IO_LOC "uart_tx_o" 17;
IO_PORT "uart_tx_o" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Status LEDs - no explicit IO_TYPE (matches Sipeed's own reference .cst;
// some of these pins share a bank with the embedded PSRAM's hardwired
// 1.8V VCCIO).
IO_LOC "leds_n_o[0]" 10;
IO_LOC "leds_n_o[1]" 11;
IO_LOC "leds_n_o[2]" 13;
IO_LOC "leds_n_o[3]" 14;
IO_LOC "leds_n_o[4]" 15;
IO_LOC "leds_n_o[5]" 16;
IO_PORT "leds_n_o[0]" DRIVE=8;
IO_PORT "leds_n_o[1]" DRIVE=8;
IO_PORT "leds_n_o[2]" DRIVE=8;
IO_PORT "leds_n_o[3]" DRIVE=8;
IO_PORT "leds_n_o[4]" DRIVE=8;
IO_PORT "leds_n_o[5]" DRIVE=8;
