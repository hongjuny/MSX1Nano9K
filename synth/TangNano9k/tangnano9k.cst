// Clock & Reset
IO_LOC "clk_27m" 52;
IO_PORT "clk_27m" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

IO_LOC "btn_reset_n" 4;
IO_PORT "btn_reset_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// HDMI (TMDS pins). tmds_*_p/_n are independent ports in top_tangnano9k.vhd
// (not a true-differential primitive pair), so nextpnr does not auto-infer
// the "_n" half from the "_p" pin's dual pin numbers - each half needs its
// own explicit IO_LOC, otherwise PnR fails with "Unconstrained IO".
IO_LOC "tmds_clk_p" 69;
IO_PORT "tmds_clk_p" PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_clk_n" 68;
IO_PORT "tmds_clk_n" PULL_MODE=NONE DRIVE=8;

IO_LOC "tmds_d_p[0]" 71;
IO_PORT "tmds_d_p[0]" PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_n[0]" 70;
IO_PORT "tmds_d_n[0]" PULL_MODE=NONE DRIVE=8;

IO_LOC "tmds_d_p[1]" 73;
IO_PORT "tmds_d_p[1]" PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_n[1]" 72;
IO_PORT "tmds_d_n[1]" PULL_MODE=NONE DRIVE=8;

IO_LOC "tmds_d_p[2]" 75;
IO_PORT "tmds_d_p[2]" PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_n[2]" 74;
IO_PORT "tmds_d_n[2]" PULL_MODE=NONE DRIVE=8;

// PS/2 Keyboard (GPIO)
IO_LOC "ps2_clk_io" 25;
IO_PORT "ps2_clk_io" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "ps2_data_io" 26;
IO_PORT "ps2_data_io" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// MicroSD Card (SPI)
IO_LOC "sd_cs_n_o" 38;
IO_PORT "sd_cs_n_o" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "sd_sclk_o" 36;
IO_PORT "sd_sclk_o" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

IO_LOC "sd_mosi_o" 37;
IO_PORT "sd_mosi_o" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

IO_LOC "sd_miso_i" 39;
IO_PORT "sd_miso_i" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// External SPI config flash (spare space holds the BIOS ROM image, read at
// boot by rom_loader/flash_reader). Same physical pins as
// andykarpov/tang9k-speccy's src/tang9k_speccy.cst on this same board.
IO_LOC "flash_clk" 59;
IO_PORT "flash_clk" IO_TYPE=LVCMOS33;
IO_LOC "flash_ncs" 60;
IO_PORT "flash_ncs" IO_TYPE=LVCMOS33;
IO_LOC "flash_do" 61;
IO_PORT "flash_do" IO_TYPE=LVCMOS33;
IO_LOC "flash_di" 62;
IO_PORT "flash_di" IO_TYPE=LVCMOS33;

// Status LEDs
// No explicit IO_TYPE, matching Sipeed's own reference .cst
// (sipeed/TangNano-9K-example/led/src/9K_LED_project.cst): some of these
// pins share a bank with the embedded PSRAM, whose VCCIO is hardwired to
// 1.8V (VCCO3_1V8) on this board, so forcing LVCMOS33 here conflicts with
// that bank's actual PSRAM-driven voltage once the PSRAM is in use.
IO_LOC "leds_n_o[0]" 10;
IO_LOC "leds_n_o[1]" 11;
IO_LOC "leds_n_o[2]" 13;
IO_LOC "leds_n_o[3]" 14;
IO_LOC "leds_n_o[4]" 15;
IO_LOC "leds_n_o[5]" 16;
IO_PORT "leds_n_o[0]" DRIVE=8;
IO_PORT "leds_n_o[1]" DRIVE=8;
IO_PORT "leds_n_o[2]" DRIVE=8;
IO_PORT "leds_n_o[3]" DRIVE=8;
IO_PORT "leds_n_o[4]" DRIVE=8;
IO_PORT "leds_n_o[5]" DRIVE=8;
